{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ovorb.ipc.v1",
  "title": "OpenVocab ORB-SLAM2 local IPC packet",
  "oneOf": [
    {
      "title": "FrameRequest",
      "type": "object",
      "required": ["protocol_version", "kind", "run_id", "frame_id", "source_timestamp_ns", "prompt_sha256", "image_width", "image_height", "jpeg_bytes"],
      "properties": {
        "protocol_version": {"const": 1},
        "kind": {"const": "frame_request"},
        "run_id": {"type": "string", "minLength": 1},
        "frame_id": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "source_timestamp_ns": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "image_width": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "image_height": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "jpeg_bytes": {"description": "MessagePack bin containing one JPEG image", "x-msgpack-type": "bin"}
      },
      "additionalProperties": false
    },
    {
      "title": "SemanticPacket",
      "type": "object",
      "required": ["protocol_version", "kind", "run_id", "frame_id", "source_timestamp_ns", "produced_timestamp_ns", "prompt_sha256", "model_manifest_sha256", "image_width", "image_height", "inference_ms", "instances"],
      "properties": {
        "protocol_version": {"const": 1},
        "kind": {"const": "semantic_packet"},
        "run_id": {"type": "string", "minLength": 1},
        "frame_id": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "source_timestamp_ns": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "produced_timestamp_ns": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "model_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "image_width": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "image_height": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "inference_ms": {"type": "number", "minimum": 0},
        "instances": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["local_id", "label", "score", "box_xyxy", "mask_rle"],
            "properties": {
              "local_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
              "label": {"type": "string", "minLength": 1},
              "score": {"type": "number", "minimum": 0, "maximum": 1},
              "box_xyxy": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
              "mask_rle": {
                "type": "object",
                "required": ["size", "counts"],
                "properties": {
                  "size": {"type": "array", "items": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "minItems": 2, "maxItems": 2},
                  "counts": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 4294967295}, "minItems": 1}
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  ]
}
